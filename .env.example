# ──────────────────────────────────────────────────────────────────────────────
# Maintain-U — Environment Variables Template
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Get this from: https://console.neon.tech → Your project → Connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# ─── File Uploads (UploadThing) ───────────────────────────────────────────────
# Get this from: https://uploadthing.com/dashboard → Your app → API Keys
UPLOADTHING_TOKEN=your_uploadthing_token_here

# ─── JWT Authentication ───────────────────────────────────────────────────────
# A long random secret used to sign session tokens.
# Generate one with: openssl rand -base64 32
# OR: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_minimum_32_characters_long

# ─── SMS Delivery ─────────────────────────────────────────────────────────────
# SMS Provider ("console" | "msg91" | "twilio") — defaults to "console"
SMS_PROVIDER=console

# MSG91 (set SMS_PROVIDER=msg91 to activate)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Twilio (set SMS_PROVIDER=twilio to activate)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Upstash Redis (for production rate limiting) ─────────────────────────────
# Get these from https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Email Delivery ───────────────────────────────────────────────────────────
# Email Provider ("console" | "resend" | "sendgrid") — defaults to "console"
EMAIL_PROVIDER=console

# Resend API Key
RESEND_API_KEY=

# SendGrid API Key
SENDGRID_API_KEY=

# Email Sender Address
EMAIL_FROM_ADDRESS=

# Admin login
ADMIN_NAME=Admin
ADMIN_PHONE=+91XXXXXXXXXX
ADMIN_PASSWORD=YourSecurePassword123